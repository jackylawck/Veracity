{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jackylawck.github.io/the-veracity/schemas/record.schema.json",
  "title": "VeracityBilingualHistoricalRecord",
  "type": "object",
  "required": [
    "record_id",
    "verification_level",
    "fixity",
    "archival_context",
    "rights_statement",
    "provenance"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+:[A-Za-z0-9_.-]+$"
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "metadata_only",
        "binary_indexed_unverified",
        "binary_verified_local_sha256",
        "binary_verified_sigstore"
      ]
    },
    "fixity": {
      "type": "object",
      "required": ["hash_algorithm", "hash_value"],
      "properties": {
        "hash_algorithm": { "type": "string", "enum": ["SHA-256", "SHA-512", "NONE"] },
        "hash_value": { "type": ["string", "null"] },
        "file_size_bytes": { "type": ["integer", "null"] }
      }
    },
    "archival_context": {
      "type": "object",
      "required": ["fonds", "series", "call_number", "repository", "title"],
      "properties": {
        "repository": {
          "type": "object",
          "required": ["en", "zh"],
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": "string" }
          }
        },
        "fonds": { "type": "string" },
        "series": { "type": "string" },
        "call_number": { "type": "string" },
        "title": {
          "type": "object",
          "required": ["en"],
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": ["string", "null"] }
          }
        },
        "covering_dates": { "type": "string" }
      }
    },
    "heuristic_clues": {
      "type": "object"
    },
    "rights_statement": {
      "type": "object",
      "required": ["license_category", "reuse_permitted", "legal_disclaimer"],
      "properties": {
        "license_category": { "type": "string" },
        "reuse_permitted": { "type": "boolean" },
        "legal_disclaimer": {
          "type": "object",
          "required": ["en", "zh"],
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": "string" }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_manifest_url", "retrieved_at_utc"],
      "properties": {
        "source_manifest_url": { "type": "string", "format": "uri" },
        "retrieved_at_utc": { "type": "string", "format": "date-time" }
      }
    }
  }
}
